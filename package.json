{
  "name": "openspec-ru",
  "version": "1.15.0",
  "description": "Русскоязычный перевод OpenSpec (Fission-AI/OpenSpec) с трекингом дрейфа апстрима",
  "type": "module",
  "bin": {
    "openspec-ru": "./tools/apply/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "apply:ru": "node tools/apply/cli.mjs apply",
    "web:start": "node tools/apply/cli.mjs start web",
    "web:stop": "node tools/apply/cli.mjs stop web",
    "manifest:seed": "node tools/seed-manifest.mjs",
    "drift:check": "node tools/drift-check.mjs",
    "drift:diff": "node tools/drift-diff.mjs",
    "mark-translated": "node tools/mark-translated.mjs",
    "translate": "node tools/translate.mjs",
    "validate:ru": "node tools/validate-translation.mjs --all",
    "lint:glossary": "node tools/validate-translation.mjs --lint ru",
    "build:ru": "node tools/build-ru.mjs",
    "release:check": "node tools/release-check.mjs",
    "test": "node --test \"tools/**/*.test.mjs\""
  }
}
